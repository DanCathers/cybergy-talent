# ==========================================================================
# Cybergy Talent — Backend environment variables (EXAMPLE)
# --------------------------------------------------------------------------
# Copy this file to ".env" and fill in real values. NEVER commit a real .env.
# ==========================================================================

# --- AI mapping (Abacus AI OpenAI-compatible endpoint) ---
# Your Abacus AI API key. Used to call the LLM that maps resume text to the
# HR Open Standards schema. Get one from https://abacus.ai
ABACUS_API_KEY=your_abacus_api_key_here

# Base URL for the OpenAI-compatible API. Leave as-is for Abacus AI.
ABACUS_BASE_URL=https://routellm.abacus.ai/v1

# The chat model used for extraction/mapping.
AI_MODEL=gpt-4o

# --- Database ---
# Async PostgreSQL connection string (SQLAlchemy + asyncpg driver).
DATABASE_URL=postgresql+asyncpg://cybergy:cybergy@postgres:5432/cybergy_talent

# --- Security ---
# Secret key for signing/session use. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=generate_a_random_secret_key_here

# Maximum accepted upload size in megabytes.
MAX_UPLOAD_SIZE_MB=10

# Comma-separated list of origins allowed by CORS (the frontend URL).
ALLOWED_ORIGINS=http://localhost:3000

# Directory where uploaded resume files are stored on disk.
STORAGE_DIR=./storage
