# =========================================================================
# Project-root environment file for Docker Compose.
#
# Copy this file to ".env" (same folder as docker-compose.yml) and fill in
# your values. Docker Compose reads it automatically to fill the
# ${ABACUS_API_KEY} and ${SECRET_KEY} placeholders in docker-compose.yml.
#
#     cp .env.example .env      (macOS/Linux)
#     copy .env.example .env    (Windows PowerShell)
# =========================================================================

# Your Abacus AI API key (required for the AI resume mapping to work)
ABACUS_API_KEY=your_abacus_api_key_here

# A random secret string used for signing (change this to anything long/random)
SECRET_KEY=change-me-to-a-long-random-string
